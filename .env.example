# Frontend Environment Variables (.env)
# Note: EXPO_PUBLIC_* variables are embedded at build time into the client app bundle.
# Never put server-only secrets (e.g. GOOGLE_CLIENT_SECRET, CLOUDINARY_API_SECRET,
# JWT_SECRET) here — those belong in backend/.env. See backend/.env.example.

# API Base URL.
# - PC web preview / iOS simulator: leave as http://localhost:5000
# - Physical device on your Wi-Fi: set http://<YOUR-PC-LAN-IP>:5000 (e.g. http://192.168.1.50:5000)
#   If unset on a physical device, the app auto-detects the Metro host IP.
# - Android emulator: auto-falls back to http://10.0.2.2:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# TMDB Configuration (for movie metadata, backdrops & posters)
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
EXPO_PUBLIC_TMDB_API_TOKEN=your_tmdb_bearer_token_here

# ----- Data Authenticity Flags -------------------------------------------
# DEMO_MODE gates ALL sample/simulated data (fallback movie catalog, sample
# theatres, simulated showtimes & seat maps) behind this explicit flag.
# Keep it false (or unset) in production: the app then only presents data it
# can verify from a real source (live TMDB "now playing", a real cinema
# provider). Default: false.
EXPO_PUBLIC_DEMO_MODE=false

# Cinema / showtime provider. Valid values:
#   none (default) -> NoopCinemaProvider; UI truthfully explains that live
#                     showtimes are not available for this location yet.
#   mock           -> MockCinemaProvider (simulated theatres/showtimes), only
#                     honored while EXPO_PUBLIC_DEMO_MODE=true.
# Real providers (e.g. vista, fandango) plug in via services/cinema/index.js.
EXPO_PUBLIC_CINEMA_PROVIDER=none

# Supabase Authentication & Storage (publishable/anon values are safe client-side)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth Client ID (Web Client ID from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary (Media uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_PRESET=your_unsigned_upload_preset