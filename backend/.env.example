# CineTrip Backend Environment Variables (.env)

PORT=5000
MONGODB_URI=mongodb://localhost:27017/cinetrip
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
CLIENT_URL=http://localhost:8081

# Supabase Server Verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth Server Verification
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudinary Media Storage (optional for server-side signing)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini API (for AI Pulse Chatbot & Recommendations)
GEMINI_API_KEY=your_gemini_api_key_here
